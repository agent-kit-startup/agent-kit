{
  "$id": "https://github.com/agent-kit-startup/agent-kit/blob/main/docs/contracts/mission-control-skins.json",
  "title": "Mission Control Interface Skins",
  "description": "Token sets of the two Mission Control Interface Skins, extracted from dashboard/dashboard.html (CSS custom properties without the leading --). Every skin shares the sharedTokens; a skin overrides exactly the surfaceTokens. A host app that embeds Mission Control reads this file to match its look without forking dashboard.html. Versioned with SemVer: an added token or skin is a minor bump; a removed or renamed token or skin id, or a changed default, is a major bump; a changed value is a patch. A test keeps it equal to dashboard.html.",
  "version": "1.0.0",
  "attribute": "data-dashboard-skin",
  "storageKey": "agent-kit:dashboard-skin",
  "defaultSkin": "bare-metal",
  "aliases": {
    "cursor": "bare-metal"
  },
  "surfaceTokens": [
    "bg-primary",
    "bg-secondary",
    "bg-card",
    "bg-card-hover",
    "border",
    "border-active",
    "text-primary",
    "text-secondary",
    "text-muted"
  ],
  "sharedTokens": {
    "green": "#22c55e",
    "green-bg": "rgba(34,197,94,0.12)",
    "yellow": "#eab308",
    "yellow-bg": "rgba(234,179,8,0.12)",
    "red": "#ef4444",
    "red-bg": "rgba(239,68,68,0.12)",
    "blue": "#3b82f6",
    "blue-bg": "rgba(59,130,246,0.12)",
    "purple": "#a855f7",
    "purple-bg": "rgba(168,85,247,0.12)",
    "cyan": "#06b6d4",
    "cyan-bg": "rgba(6,182,212,0.12)",
    "orange": "#f97316",
    "orange-bg": "rgba(249,115,22,0.12)",
    "mc-header-height": "32px",
    "mc-header-control-size": "24px",
    "mc-top-tabs-height": "40px",
    "mc-radius-sm": "4px",
    "mc-radius-chrome": "6px",
    "mc-radius": "8px",
    "mc-radius-lg": "12px",
    "mc-radius-pill": "999px",
    "mc-space-xs": "4px",
    "mc-space-sm": "6px",
    "mc-space-md": "8px",
    "mc-space-lg": "12px",
    "mc-space-xl": "16px",
    "mc-space-2xl": "24px",
    "mc-card-padding": "16px",
    "mc-card-padding-dense": "10px 12px",
    "mc-header-pad-x": "24px",
    "mc-header-pad-x-end": "8px",
    "mc-content-pad": "24px",
    "mc-scroll-gutter": "8px",
    "header-height": "var(--mc-header-height)",
    "top-tabs-height": "var(--mc-top-tabs-height)",
    "radius": "var(--mc-radius)",
    "radius-lg": "var(--mc-radius-lg)",
    "mc-font-sans": "system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif",
    "mc-font-mono": "ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, \"Liberation Mono\", \"Courier New\", monospace",
    "mc-ui-font-size": "13px",
    "mc-chrome-label-size": "13px",
    "mc-chrome-label-weight": "500",
    "mc-chrome-label-gap": "6px",
    "mc-chrome-icon-size": "16px",
    "mc-chrome-subtitle-size": "12px",
    "mc-chrome-subtitle-weight": "400",
    "mc-chrome-meta-size": "11px",
    "mc-chrome-meta-weight": "400",
    "mc-status-dot-size": "7px"
  },
  "skins": {
    "bare-metal": {
      "label": "Bare Metal",
      "logo": "dashboard/logo-bare-metal.svg",
      "tokens": {
        "bg-primary": "#141414",
        "bg-secondary": "#181818",
        "bg-card": "#1c1c1c",
        "bg-card-hover": "#242424",
        "border": "#2a2a2a",
        "border-active": "#3a3a3a",
        "text-primary": "#e4e4e4",
        "text-secondary": "#a0a0a0",
        "text-muted": "#8b8b8b"
      }
    },
    "legacy": {
      "label": "Legacy",
      "logo": "dashboard/logo.svg",
      "tokens": {
        "bg-primary": "#0b0e14",
        "bg-secondary": "#111620",
        "bg-card": "#161c2a",
        "bg-card-hover": "#1b2335",
        "border": "#1e2a3a",
        "border-active": "#2a3a5a",
        "text-primary": "#e2e8f0",
        "text-secondary": "#8899aa",
        "text-muted": "#7f93a8"
      }
    }
  }
}
