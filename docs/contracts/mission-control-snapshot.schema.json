{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/agent-kit-startup/agent-kit/blob/main/docs/contracts/mission-control-snapshot.schema.json",
  "title": "Mission Control snapshot",
  "description": "Output of dashboard/dashboard-data.mjs (one JSON document per refresh). Versioned by dashboardDataVersion: an added field or collector is a minor bump, a removed or retyped top-level field is a major bump. Only the top level, the runLogs rows, the gateExit tickets and the chats envelopes and sessions are fixed here; nested collector shapes may grow without a bump (additionalProperties stays open).",
  "version": "1.7.0",
  "type": "object",
  "required": [
    "_schema",
    "generatedAt",
    "dashboardDataVersion",
    "plans",
    "system",
    "agents",
    "commands",
    "memory",
    "git",
    "terminals",
    "runLogs",
    "gateExit",
    "chats",
    "processes",
    "skills",
    "health",
    "missionControl",
    "devops"
  ],
  "properties": {
    "_schema": { "type": "object", "required": ["version", "fields"] },
    "generatedAt": { "type": "string" },
    "dashboardDataVersion": { "type": "string", "const": "1.7.0" },
    "plans": { "type": "array" },
    "system": { "type": "object", "required": ["repoRoot"] },
    "agents": { "type": "array" },
    "commands": { "type": "array" },
    "memory": { "type": "object" },
    "git": { "type": "object" },
    "terminals": { "type": "array" },
    "runLogs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "path",
          "updatedAt",
          "source",
          "format",
          "lastText",
          "result",
          "sentinel",
          "gates",
          "replies"
        ],
        "properties": {
          "id": { "type": "string" },
          "kind": { "enum": ["tick", "run"] },
          "path": { "type": "string" },
          "updatedAt": { "type": "string" },
          "source": { "const": "loop-logs" },
          "format": { "enum": ["stream-json", "codex", "acp", null] },
          "lastText": { "type": "string" },
          "result": { "type": ["object", "null"] },
          "sentinel": { "type": ["string", "null"] },
          "gates": { "type": "array" },
          "replies": { "type": "array" }
        }
      }
    },
    "gateExit": {
      "type": "object",
      "required": ["marker", "base", "tickets", "skipped", "truncated"],
      "properties": {
        "marker": { "enum": ["absent", "ok", "invalid"] },
        "base": { "type": "string" },
        "tickets": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "stamp",
              "headline",
              "askId",
              "labels",
              "trigger",
              "openedAt",
              "url",
              "branch",
              "branchState",
              "inMarker"
            ],
            "properties": {
              "stamp": { "type": "string" },
              "headline": { "type": ["string", "null"] },
              "askId": { "type": ["string", "null"] },
              "labels": { "type": "array" },
              "trigger": { "enum": ["gate", "stopped-by-operator", "failure", "review", null] },
              "openedAt": { "type": ["string", "null"] },
              "url": { "type": ["string", "null"] },
              "branch": { "type": ["string", "null"] },
              "branchState": { "enum": ["unmerged", "merged", "none"] },
              "inMarker": { "type": "boolean" }
            }
          }
        },
        "skipped": { "type": "array" },
        "truncated": { "type": "boolean" }
      }
    },
    "chats": {
      "type": "object",
      "required": ["withheld", "vendors"],
      "properties": {
        "withheld": { "type": "boolean" },
        "vendors": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["vendor", "status", "projectDir", "sessions", "total"],
            "properties": {
              "vendor": { "enum": ["claude", "codex", "cursor"] },
              "status": { "enum": ["ok", "unsupported", "none"] },
              "projectDir": { "type": ["string", "null"] },
              "sessions": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["id", "title", "titleSource", "modified", "sizeBytes"],
                  "properties": {
                    "id": { "type": "string" },
                    "title": { "type": ["string", "null"] },
                    "titleSource": { "enum": ["custom", "ai", "first-prompt", "none"] },
                    "modified": { "type": "number" },
                    "sizeBytes": { "type": "number" }
                  }
                }
              },
              "total": { "type": "number" }
            }
          }
        }
      }
    },
    "processes": { "type": "array" },
    "skills": { "type": "array" },
    "health": { "type": "object", "required": ["status", "checks"] },
    "missionControl": { "type": ["object", "null"] },
    "devops": { "type": "object", "required": ["pipeline", "deploy"] }
  },
  "additionalProperties": true
}
