{
  "name": "@dadado/agent-kit-cli",
  "version": "5.5.0",
  "description": "Agent Kit CLI: HITL framework install and tooling for AI-assisted IDEs (rules, skills, plan/handoff, context).",
  "license": "PolyForm-Noncommercial-1.0.0",
  "type": "module",
  "bin": {
    "agent-kit": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "dashboard",
    "LICENSE"
  ],
  "scripts": {
    "sync-dashboard": "node ../../scripts/sync-cli-dashboard.mjs",
    "prepack": "node ../../scripts/sync-cli-dashboard.mjs",
    "prepublishOnly": "node ../../scripts/verify-cli-dashboard-pack.mjs",
    "build": "node ../../scripts/sync-cli-dashboard.mjs && tsup src/index.ts --format esm --dts --clean",
    "dev": "tsx src/index.ts",
    "start": "tsx src/index.ts",
    "lint": "biome check src",
    "overlay:hashes": "tsx src/lifecycle/refresh-known-hashes.ts",
    "overlay:hashes:check": "tsx src/lifecycle/refresh-known-hashes.ts --check",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@clack/prompts": "^0.8.2",
    "citty": "^0.1.6",
    "kolorist": "^1.8.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.1",
    "tsup": "^8.4.0",
    "tsx": "^4.19.3",
    "vite": "^7.3.5",
    "vitest": "^3.2.6"
  }
}
